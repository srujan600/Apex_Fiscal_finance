# ============================================================
# APEX FISCAL — ENVIRONMENT CONFIGURATION
# ============================================================

# 1. Aczen Nova Data Ingestion Layer (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Dedicated exclusively to pulling external ERP / general ledger data (budgets, expenses, cost centers)
NOVA_API_KEY=your_aczen_nova_api_key_here
NOVA_BASE_URL=https://www.aczen.in/nova-api/v1

# 2. Google Gemini Conversational Intelligence Layer (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Dedicated exclusively to Copilot chatbot reasoning, RAG grounding, policy compliance, spend simulation
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Database Configuration (Native SQLite)
DATABASE_PATH=./data/apex_fiscal.db

# Authentication & Session Secrets
AUTH_SECRET=apex_fiscal_dev_jwt_secret_change_in_production
